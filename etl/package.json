{
  "name": "@gramledger/etl",
  "version": "0.1.0",
  "private": true,
  "description": "GramLedger ETL framework — reusable ingestion pipeline (fetch → parse → validate → normalize → deduplicate → transform → load → report)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown \"src/**/*.ts\" \"sources/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json,mjs}\"",
    "format:check": "prettier --check --ignore-unknown \"src/**/*.ts\" \"sources/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "node-html-parser": "^9.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
