# Copy to `etl/.env` and fill in (or export in your shell / CI). Never commit real credentials.
# See etl/README.md for the full list of variables and defaults.

# Runtime environment: development | test | production
ETL_ENV=development
# Log level: debug | info | warn | error
ETL_LOG_LEVEL=info
# Retries for the fetch stage (transient failures only)
ETL_RETRY_ATTEMPTS=3
ETL_RETRY_BASE_BACKOFF_MS=1000
ETL_RETRY_MAX_BACKOFF_MS=30000
# Records per load batch (single transaction per batch)
ETL_BATCH_SIZE=1000
# Where dead-lettered records are written (relative to the working directory)
ETL_DEAD_LETTER_DIR=etl/.dead-letter

# Optional: used by the Postgres sinks (audit + loaders)
# DATABASE_URL=postgres://user:password@localhost:5432/gramledger
