# Copy to `.env.test` and fill in. Never commit real credentials.
# Used by `npm run db:migrate:test` (and `:test:down`). Point this at a
# scratch database (local Postgres or a disposable Neon branch) — never a
# database you care about, since tests may drop and recreate the schema.
DATABASE_URL=postgres://user:password@localhost:5432/gramledger_test
