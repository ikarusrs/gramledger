{
  "name": "@gramledger/database",
  "version": "0.1.0",
  "private": true,
  "description": "GramLedger PostgreSQL schema migrations and seeds (Neon)",
  "type": "module",
  "scripts": {
    "migrate": "bash scripts/run-migrate.sh up -m \"migrations/*.sql\" --use-glob",
    "migrate:create": "node-pg-migrate create -j sql",
    "migrate:down": "bash scripts/run-migrate.sh down -m \"migrations/*.sql\" --use-glob",
    "migrate:up": "bash scripts/run-migrate.sh up -m \"migrations/*.sql\" --use-glob",
    "migrate:test": "bash scripts/run-migrate.sh --env .env.test up -m \"migrations/*.sql\" --use-glob",
    "migrate:test:down": "bash scripts/run-migrate.sh --env .env.test down -m \"migrations/*.sql\" --use-glob",
    "seed": "bash scripts/seed.sh",
    "lint": "bash scripts/check-sql.sh",
    "format": "bash scripts/check-sql.sh --fix",
    "format:check": "bash scripts/check-sql.sh"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.0"
  }
}
