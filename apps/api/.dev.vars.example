# Local-only overrides for `wrangler dev`. Copy to `.dev.vars`.
# These values are never committed. Production values are set via
# `wrangler secret put <KEY>` or the Cloudflare dashboard.
ENVIRONMENT=development
LOG_LEVEL=debug
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
YOUTUBE_API_KEY=your-google-cloud-youtube-data-api-key
DATA_GOV_API_KEY=your-data-gov-api-key
DATA_GOV_MARKET_RESOURCE=your-agmarknet-resource-id
RESEND_API_KEY=re_your-resend-api-key
AUTH_FROM_EMAIL=GramLedger <auth@example.com>
JWT_SECRET=replace-with-a-long-random-secret
# In local development, Resend can be omitted and the OTP appears in the app.
